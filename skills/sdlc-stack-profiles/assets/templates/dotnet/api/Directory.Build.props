<Project>

  <!-- Organization baseline for every scaffolded .NET solution.
       One settings file at the solution root: analyzers run in the
       build at the recommended level, code style is enforced in the
       build, and warnings fail the build — a warning that scrolls
       past is a defect that ships. Per-project csproj files carry
       only what is specific to that project. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
