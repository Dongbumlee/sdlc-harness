/target
# Cargo.lock is a build artefact for this type (see Cargo.toml):
# generated by the install step, never committed.
Cargo.lock
dist/
*.profraw
.idea/
.vscode/
.DS_Store

# Secrets and local configuration — never commit real values;
# configuration arrives through environment variables (see SECURITY.md)
.env
.env.*
!.env.example
*.pem
*.key
