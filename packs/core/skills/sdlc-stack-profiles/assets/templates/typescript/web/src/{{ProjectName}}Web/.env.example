# Configuration is split (see src/lib/config.ts and
# src/lib/server-config.ts). Copy to .env.local and fill in local
# values. Never commit a real .env.local.

# --- Public: inlined into the client bundle. Browser-safe only;
# anything here is world-readable by design.
# NEXT_PUBLIC_APP_NAME={{ProjectName}}

# --- Server-only: no prefix, never inlined, readable only by
# server components, route handlers, and build-time code. Client
# components must never import lib/server-config (the
# architecture test enforces it).
# SERVER_API_KEY=
