# Copy to .env and fill in local values. Never commit a real .env.
# Variable names are prefixed with the tool name upper-cased and
# hyphens as underscores — for a tool named task-tracker the two
# settings below are TASK_TRACKER_DB_PATH and TASK_TRACKER_POLL_INTERVAL.
# <PREFIX>_DB_PATH=worker.db
# <PREFIX>_POLL_INTERVAL=0.5
